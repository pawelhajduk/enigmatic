# Copy to .env. Enigmatic loads .env and .env.local on startup.
# Process environment variables win. .env.local wins over .env.
# Do not commit .env.

# Local proxy access token. When set, clients must send:
#   Authorization: Bearer <token>
# The OpenAI SDK sends this from api_key=. Leave empty to keep the proxy open.
ENIGMATIC_API_KEY=

# Upstream keys named by api_key_env in conf/providers.yaml.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
